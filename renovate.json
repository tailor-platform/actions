{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tailor-inc/renovate-config",
    ":pinAllExceptPeerDependencies",
    ":disableDependencyDashboard"
  ],
  "dependencyDashboardApproval": false,
  "timezone": "Asia/Tokyo",
  "schedule": ["* 9-18 * * 1-5"],
  "constraints": {
    "ghActionsLock": "v0.2.0"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the gh-actions-lock version that Renovate and the actions:lock:* scripts use for .github/workflows/actions.lock",
      "managerFilePatterns": ["/^renovate\\.json$/"],
      "matchStrings": ["\"ghActionsLock\": \"(?<currentValue>v[\\d.]+)\""],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Enable major updates without dashboard approval (dashboard is disabled)",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Enable renovate for tests directory",
      "matchFileNames": [
        "tests/**"
      ],
      "enabled": true
    }
  ]
}
